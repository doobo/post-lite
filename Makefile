BINARY := bin/postlite
PKG := ./cmd/postlite
# Offline password recovery tool (see cmd/pwreset): one binary, no server needed.
PWRESET := bin/pwreset
PWRESET_PKG := ./cmd/pwreset

DIST ?= dist
# Version stamped into the license bundle header; release.yml passes the tag.
VERSION ?= $(shell git describe --tags --always --dirty 2>/dev/null || echo dev)

.PHONY: build run vet test clean web pwreset licenses

build:
	go build -ldflags="-s -w" -o $(BINARY) $(PKG)
	go build -ldflags="-s -w" -o $(PWRESET) $(PWRESET_PKG)

pwreset:
	go build -ldflags="-s -w" -o $(PWRESET) $(PWRESET_PKG)

run: build
	./$(BINARY) -addr :5680 -data ./data -timeout 60s -max-history 1000

run-plain: build
	./$(BINARY) -plain -addr 127.0.0.1:5681 -data ./data

vet:
	go vet ./...

test:
	go test ./...

clean:
	rm -rf bin data

# Collect every dependency's license text into $(DIST)/THIRD_PARTY_LICENSES so the
# release archives carry their notices. Module list comes from go.mod (which is
# exactly the set compiled into the binaries); texts from the module cache.
licenses:
	@mkdir -p $(DIST)
	@go mod download
	@out="$(DIST)/THIRD_PARTY_LICENSES"; \
	{ \
		echo "PostLite $(VERSION) third-party licenses"; \
		echo "================================================================"; \
		echo "Generated by make licenses, do not edit by hand."; \
		echo "PostLite itself is MIT licensed, see LICENSE next to this file."; \
		echo "Module versions as required by go.mod."; \
		echo; \
		for path in $$(sed -n 's/^[[:space:]]*\([^[:space:]]*\)[[:space:]]*v[^[:space:]]*.*/\1/p' go.mod); do \
			info="$$(go list -m -f '{{.Path}}@{{.Version}} {{.Dir}}' "$$path" 2>/dev/null)"; \
			dir="$${info##* }"; \
			module="$${info%% *}"; \
			if [ -z "$$dir" ] || [ ! -d "$$dir" ]; then \
				echo "missing module cache: $$path (run go mod download)" >&2; exit 1; \
			fi; \
			files=""; first=""; \
			for f in "$$dir"/LICENSE* "$$dir"/LICENCE* "$$dir"/COPYING* "$$dir"/NOTICE*; do \
				if [ -f "$$f" ]; then \
					files="$$files $$f"; \
					if [ -z "$$first" ]; then first="$$f"; fi; \
				fi; \
			done; \
			if [ -z "$$first" ]; then echo "no license file: $$path ($$dir)" >&2; exit 1; fi; \
			label="see text below"; \
			if grep -q "Permission is hereby granted, free of charge" "$$first"; then label="MIT"; \
			elif grep -q "Redistribution and use in source and binary forms" "$$first"; then label="BSD-3-Clause"; \
			elif grep -q "Apache License" "$$first"; then label="Apache-2.0"; \
			fi; \
			echo "----------------------------------------------------------------"; \
			echo "$$module"; \
			echo "License: $$label"; \
			echo "----------------------------------------------------------------"; \
			for f in $$files; do echo "[$$(basename "$$f")]"; cat "$$f"; echo; done; \
		done; \
	} > "$$out"
	@cp LICENSE $(DIST)/LICENSE
	@echo "wrote $(DIST)/THIRD_PARTY_LICENSES and $(DIST)/LICENSE"

# Frontend is plain static files under internal/web/static (no build step);
# edit them directly, they are embedded into the binary via go:embed.
web:
	@echo "static UI lives in internal/web/static (embedded, no build step)"
